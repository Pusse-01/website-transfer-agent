# Builder.io Configuration
BUILDER_API_KEY=your_builder_private_api_key_here
BUILDER_PUBLIC_KEY=your_builder_public_api_key_here

# Source Website Configuration
SOURCE_BASE_URL=https://www.pricerite.com.hk
SOURCE_BLOG_PATH=/news/

# Optional: Default Excel file paths
BLOG_LIST_EXCEL=Blog_Post_List.xlsx
STATIC_PAGE_LIST_EXCEL=Static_Page_List.xlsx

# Builder.io Content Models
# Check your model API names in Builder.io > Models settings
BUILDER_BLOG_MODEL=blog-post
BUILDER_PAGE_MODEL=page

# Optional: OpenAI-powered layout fixer
# When OPENAI_API_KEY is set, the migration pipeline renders the processed
# HTML and the original page, sends both screenshots to a vision model, and
# asks it to rewrite the HTML so the layout matches the original BEFORE the
# content is uploaded to Builder.io. Leave unset to skip this step.
OPENAI_API_KEY=
# Most intelligent vision model available via the OpenAI API (April 2025).
# The pipeline falls back to gpt-4o automatically on 400 errors, and retries
# up to 3 times with exponential backoff on 429 rate-limit errors.
OPENAI_MODEL=gpt-4.1
# Set LLM_LAYOUT_FIX=0 to force-disable the fixer even when a key is present.
LLM_LAYOUT_FIX=1

# Magento admin (optional) — only needed if the URLs you're migrating are
# NOT publicly accessible. Public CMS pages like /hk/zh/intro-fur-tips don't
# require login. When set, the live capture step logs in before rendering.
MAGENTO_ADMIN_URL=https://www.pricerite.com.hk/adminControl/
MAGENTO_USERNAME=
MAGENTO_PASSWORD=

# Streamlit App
# Run with: streamlit run streamlit_app.py
